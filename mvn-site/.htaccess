RedirectMatch ^/reference/(.*)$ /archives/maven-1.x/reference/$1
RedirectMatch ^/maven-1.x/reference/plugins/(.*)$ /archives/maven-1.x/plugins/$1
RedirectMatch ^/maven-aether-provider/(.*)$ /ref/3.10.0/maven-aether-provider/$1
RedirectMatch ^/maven-artifact/(.*)$ /ref/3.10.0/maven-artifact/$1
RedirectMatch ^/maven-compat/(.*)$ /ref/3.10.0/maven-compat/$1
RedirectMatch ^/maven-core/(.*)$ /ref/3.10.0/maven-core/$1
RedirectMatch ^/maven-embedder/(.*)$ /ref/3.10.0/maven-embedder/$1
RedirectMatch ^/maven-model/(.*)$ /ref/3.10.0/maven-model/$1
