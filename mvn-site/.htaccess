RedirectMatch permanent ^/pom/skins(.*)$ /pom/maven/maven-skins$1
RedirectMatch permanent ^/shared/maven-doxia-tools/(.*)$ /doxia/doxia-tools/doxia-integration-tools/$1
RedirectMatch permanent ^/shared/maven-plugin-testing-harness/(.*)$ /plugin-testing/maven-plugin-testing-harness/$1
RedirectMatch permanent ^/shared/maven-plugin-testing-tools/(.*)$ /plugin-testing/maven-plugin-testing-tools/$1
