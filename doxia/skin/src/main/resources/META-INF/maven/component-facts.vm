## What a page of a component site says about itself: the version it documents, where to edit it, or
## for a page generated from the code (a goal, a report), where that code is.
## Set by site.vm: $factsClass, $editUrl, $sourceUrl, $pageTitle.
<section class="$factsClass" aria-label="About this page">
  <dl>
    <dt>Version</dt>
    <dd>$esc.xml( $project.version )</dd>
#if( $editUrl )
    <dt>Source</dt>
    <dd><a href="$editUrl">Edit this page</a></dd>
#elseif( $sourceUrl )
    <dt>Source</dt>
    <dd>Generated from <a href="$sourceUrl">the code</a></dd>
#end
#if( $project.issueManagement && $project.issueManagement.url )
    <dt>Wrong?</dt>
    <dd><a href="$project.issueManagement.url">Report a problem</a></dd>
#end
  </dl>
</section>
