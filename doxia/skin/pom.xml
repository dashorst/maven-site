<!--
  The skin of the example: the frame of every page (META-INF/maven/site.vm), its stylesheet,
  images and the one optional script. Install it before building the site:

    mvn -f doxia/skin/pom.xml install
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.dashorst.maven-site</groupId>
  <artifactId>maven-example-skin</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Skin of the maven.apache.org example</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-27T00:00:00Z</project.build.outputTimestamp>
  </properties>
</project>
